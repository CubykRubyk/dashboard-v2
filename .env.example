DATABASE_URL="postgresql://dashboard:change-me@localhost:5432/dashboard?schema=public"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"
TECHNICAL_DOCUMENT_STORAGE_ROOT="./data/pac-documents"
INTERVENTION_PHOTO_STORAGE_ROOT="./data/intervention-photos"
SAV_ATTACHMENT_STORAGE_ROOT="./data/sav-attachments"
# OBSOLÈTE — la configuration e-mail se règle désormais dans Paramètres → Notifications
# (stockée chiffrée en base). Ces variables ne sont plus lues.
# RESEND_API_KEY=""
# EMAIL_FROM="SAV 2C Energies <sav@exemple.fr>"
# OBSOLÈTE — les clés push se génèrent depuis Paramètres → Notifications (stockées chiffrées en
# base). Ces variables ne sont plus lues ; `scripts/migrate-notification-env.ts` reprend une
# configuration existante une bonne fois pour toutes.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:contact@2cenergies.fr"
DB_BACKUP_STORAGE_ROOT="./data/db-backups"
# Nombre de sauvegardes conservées (les plus anciennes sont supprimées). Défaut : 30.
DB_BACKUP_KEEP="30"
# Secret attendu dans l'en-tête `x-cron-secret` par POST /api/cron/backup (sauvegarde programmée).
# Sans lui, la route est désactivée.
CRON_SECRET="replace-with-a-random-secret"
# Chemins vers pg_dump/pg_restore si absents du PATH (ex. développement local sans client Postgres).
# PG_DUMP_BIN="/opt/homebrew/opt/postgresql@17/bin/pg_dump"
# PG_RESTORE_BIN="/opt/homebrew/opt/postgresql@17/bin/pg_restore"
# "true" uniquement en production réelle derrière HTTPS — sinon le cookie de session ne peut ni
# être stocké ni renvoyé par le navigateur (accès LAN en HTTP simple, ex. test PWA sur téléphone).
COOKIE_SECURE="true"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Administrator"
