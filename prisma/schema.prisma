generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
  TECHNICIEN
}

enum MaterialInputType {
  CHECKBOX
  QUANTITY
  SELECT
  DETAIL
}

enum MaterialUnit {
  NONE
  PIECE
  METER
  BAG
  RADIATOR
}

enum WorkSheetStatus {
  DRAFT
  COMPLETED
  SENT
}

enum MaterialSupplier {
  COMPANY
  INTERNAL
}

enum HeatPumpType {
  AIR_WATER
  AIR_AIR
  GROUND_WATER
}

enum HeatPumpConfiguration {
  SPLIT
  MONOBLOC
}

enum HeatPumpSplitLiaisonType {
  FRIGORIFIC
  HYDRAULIC
}

enum ElectricalSupply {
  SINGLE_PHASE
  THREE_PHASE
}

enum PacDocumentType {
  INSTALLATION_MANUAL
  USER_MANUAL
  DATASHEET
  WIRING_DIAGRAM
  ERROR_CODES
  CERTIFICATE
  OTHER
}

enum EquipmentType {
  INDOOR_UNIT
  OUTDOOR_UNIT
  MONOBLOC
  ACCESSORY
  CONTROLLER
  OTHER
}

enum TechnicalDocumentType {
  INSTALLATION_MANUAL
  USER_MANUAL
  DATASHEET
  WIRING_DIAGRAM
  ERROR_CODES
  CERTIFICATE
  OTHER
}

enum SavPriority {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum SavStatus {
  OUVERT
  CLOTURE
}

enum SavHistoryType {
  NOTE
  STATUS
  PRIORITY
  CLOSURE
  PLANNING
}

// Provenance d'un ticket : saisi en interne, ou reçu via le formulaire public destiné aux
// sociétés clientes (`/sav-request`).
enum SavOrigin {
  INTERNAL
  CLIENT_FORM
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String
  passwordHash           String
  role                   UserRole            @default(OPERATOR)
  active                 Boolean             @default(true)
  lastLoginAt            DateTime?
  teamId                 String?
  team                   Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // `userownerid` de l'utilisateur correspondant dans Dolibarr. C'est ce qui permet de savoir
  // quelles interventions appartiennent à quel technicien : `InterventionPlanning.team` n'est
  // qu'un nom affiché, sans garantie d'unicité.
  dolibarrUserId         String?             @unique
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  auditLogs              AuditLog[]
  workSheets             WorkSheet[]
  createdDocumentTemplates DocumentTemplate[] @relation("DocumentTemplatesCreated")
  generatedDocuments     GeneratedDocument[] @relation("DocumentsGenerated")
  createdSavTickets      SavTicket[]         @relation("SavTicketsCreated")
  savHistoryEntries      SavHistoryEntry[]
  dismissedProximitySuggestions SavProximitySuggestion[]
  uploadedWorkSheetPhotos WorkSheetPhoto[]   @relation("WorkSheetPhotosUploaded")
  uploadedSavAttachments SavAttachment[]     @relation("SavAttachmentsUploaded")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
}

model Team {
  id         String      @id @default(cuid())
  name       String      @unique
  active     Boolean     @default(true)
  members    User[]
  savTickets SavTicket[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([active, name])
}

model SavTicket {
  id                String            @id @default(cuid())
  reference         String            @unique
  title             String
  company           String
  contact           String
  phone             String            @default("")
  address           String            @default("")
  equipment         String            @default("")
  description       String            @default("")
  priority          SavPriority       @default(NORMALE)
  status            SavStatus         @default(OUVERT)
  teamId            String?
  team              Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  desiredDate       DateTime?
  closedAt          DateTime?
  closureReason     String?
  closureNote       String?
  planningDate      DateTime?
  planningStartTime String?
  planningEndTime   String?
  planningNote      String?
  latitude          Float?
  longitude         Float?
  // Adresse de contact du demandeur : sert aux e-mails de suivi (accusé de réception puis
  // changements de statut). Vide pour les tickets créés en interne sans contact e-mail connu.
  contactEmail      String            @default("")
  origin            SavOrigin         @default(INTERNAL)
  // Facultatif : un ticket reçu par le formulaire public n'a pas d'auteur interne.
  createdById       String?
  createdBy         User?             @relation("SavTicketsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  history           SavHistoryEntry[]
  attachments       SavAttachment[]
  proximitySuggestions SavProximitySuggestion[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, priority])
  @@index([teamId])
}

// Notifications **persistées**, par destinataire. À ne pas confondre avec `GET /api/notifications`
// historique, qui recalculait un état courant à la volée (SAV sans équipe, suggestions…) et ne
// pouvait donc pas dire « X a créé le SAV Y à telle heure ».
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String    @default("")
  // Cible optionnelle, pour construire un lien de rebond vers l'entité concernée.
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Abonnement Web Push d'un appareil. Un utilisateur peut en avoir plusieurs (téléphone, tablette).
// `endpoint` identifie l'abonnement côté service de push du navigateur : il est unique par
// appareil et change à chaque réabonnement.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// Photos et documents joints à un SAV — par un opérateur depuis le dashboard, ou par la société
// cliente depuis le formulaire public. Même principe que `WorkSheetPhoto` : métadonnées en base
// (dont le checksum), binaire sur disque sous un nom UUID.
model SavAttachment {
  id               String    @id @default(cuid())
  savTicketId      String
  savTicket        SavTicket @relation(fields: [savTicketId], references: [id], onDelete: Cascade)
  storageName      String    @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  // `null` quand la pièce vient du formulaire public (aucune session).
  uploadedById     String?
  uploadedBy       User?     @relation("SavAttachmentsUploaded", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([savTicketId, createdAt])
}

// Répertoire des utilisateurs Dolibarr, importé pour éviter de saisir `userownerid` à la main et
// pour alimenter les sélecteurs d'affectation. **Ce ne sont pas des comptes de connexion** : un
// utilisateur Dolibarr n'a pas forcément sa place dans le CRM (comptabilité, direction…).
model DolibarrUser {
  id         String   @id @default(cuid())
  dolibarrId String   @unique
  // `lastname` + `firstname`, avec repli sur `login` : sur cette instance `firstname` est souvent
  // vide et `lastname` porte le nom entier.
  name       String
  login      String   @default("")
  email      String   @default("")
  job        String   @default("")
  color      String   @default("")
  isEmployee Boolean  @default(true)
  active     Boolean  @default(true)
  favorite   Boolean  @default(false)
  syncedAt   DateTime @updatedAt

  @@index([favorite, name])
  @@index([active, name])
}

// Répertoire des sociétés clientes (`socid`). Seuls les tiers marqués client sont importés : un
// fournisseur n'a rien à faire dans le sélecteur de société d'une intervention.
model DolibarrCompany {
  id         String   @id @default(cuid())
  dolibarrId String   @unique
  name       String
  address    String   @default("")
  zip        String   @default("")
  town       String   @default("")
  clientCode String   @default("")
  active     Boolean  @default(true)
  favorite   Boolean  @default(false)
  syncedAt   DateTime @updatedAt

  @@index([favorite, name])
  @@index([active, name])
}

model InterventionPlanning {
  id              String    @id @default(cuid())
  dolibarrEventId String    @unique
  reference       String
  title           String
  company         String    @default("")
  address         String    @default("")
  latitude        Float?
  longitude       Float?
  startAt         DateTime?
  endAt           DateTime?
  team            String    @default("")
  // Identifiant brut du propriétaire Dolibarr (`userownerid`), conservé en plus du nom affiché
  // (`team`) pour rattacher l'intervention à un compte `User` via `User.dolibarrUserId`.
  dolibarrOwnerId String?
  color           String?
  status          SavStatus @default(OUVERT)
  // Dernière erreur d'écriture vers Dolibarr pour cette intervention (même principe que
  // `WorkSheet.dolibarrLastError`), effacée au succès suivant.
  dolibarrLastError String?
  proximitySuggestions SavProximitySuggestion[]
  materials       InterventionMaterial[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([startAt])
  @@index([dolibarrOwnerId])
}

// Matériel que le technicien doit poser sur l'intervention. Toujours une référence du catalogue
// (jamais du texte libre) : c'est ce qui permet de lui présenter la documentation du matériel
// concerné une fois sur le chantier.
model InterventionMaterial {
  id             String               @id @default(cuid())
  interventionId String
  intervention   InterventionPlanning @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  equipmentId    String
  // `Restrict` : supprimer du catalogue une référence déjà posée sur un chantier doit être refusé,
  // pas effacer silencieusement l'historique de l'intervention.
  equipment      Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  quantity       Int                  @default(1)
  note           String               @default("")
  createdAt      DateTime             @default(now())

  @@unique([interventionId, equipmentId])
  @@index([equipmentId])
}

model SavProximitySuggestion {
  id                           String    @id @default(cuid())
  savTicketId                  String
  savTicket                    SavTicket @relation(fields: [savTicketId], references: [id], onDelete: Cascade)
  interventionId               String
  intervention                 InterventionPlanning @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  distanceKm                   Float
  travelMinutes                Int
  dismissed                    Boolean   @default(false)
  dismissedAt                  DateTime?
  dismissedById                String?
  dismissedBy                  User?     @relation(fields: [dismissedById], references: [id], onDelete: SetNull)
  savAddressSnapshot           String
  interventionStartAtSnapshot  DateTime?
  interventionTeamSnapshot     String
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([savTicketId, interventionId])
  @@index([savTicketId])
  @@index([interventionId])
}

model SavHistoryEntry {
  id          String         @id @default(cuid())
  savTicketId String
  savTicket   SavTicket      @relation(fields: [savTicketId], references: [id], onDelete: Cascade)
  type        SavHistoryType
  text        String
  detail      String?
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([savTicketId, createdAt])
}

model MaterialCategory {
  id        String     @id @default(cuid())
  key       String     @unique
  name      String
  position  Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  materials Material[]
}

model Material {
  id                String            @id @default(cuid())
  key               String            @unique
  name              String
  reportLabel       String
  inputType         MaterialInputType @default(CHECKBOX)
  unit              MaterialUnit      @default(PIECE)
  defaultQuantity   Float             @default(1)
  detailLabel       String?
  position          Int               @default(0)
  active            Boolean           @default(true)
  allowSupplier     Boolean           @default(true)
  allowNotInstalled Boolean           @default(true)
  categoryId        String
  category          MaterialCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants          MaterialVariant[]
  workSheetItems    WorkSheetItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([categoryId, position])
}

model MaterialVariant {
  id             String          @id @default(cuid())
  name           String
  reportLabel    String
  position       Int             @default(0)
  active         Boolean         @default(true)
  materialId     String
  material       Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workSheetItems WorkSheetItem[]

  @@unique([materialId, name])
  @@index([materialId, position])
}

model WorkSheet {
  id                String                  @id @default(cuid())
  legacyId          String?                 @unique
  workDate          DateTime?
  client            String
  company           String
  installer         String
  eventId           String?
  mainInstallations String                  @default("")
  otherMaterials    String                  @default("")
  reportText        String                  @default("")
  reportFrozen      Boolean                 @default(false)
  status            WorkSheetStatus         @default(DRAFT)
  dolibarrSentAt    DateTime?
  dolibarrLastError String?
  archivedAt        DateTime?
  createdById       String
  createdBy         User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  installations     WorkSheetInstallation[]
  items             WorkSheetItem[]
  photos            WorkSheetPhoto[]
  tags              WorkSheetTag[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([workDate])
  @@index([archivedAt, createdAt])
}

// Photos prises sur le chantier depuis le mobile. Même principe que `GeneratedDocument` : les
// métadonnées (dont le checksum, pour vérifier qu'un fichier n'a pas été altéré) vivent en base,
// le binaire sur disque sous un nom UUID (voir lib/documents/storage.ts).
model WorkSheetPhoto {
  id               String    @id @default(cuid())
  workSheetId      String
  workSheet        WorkSheet @relation(fields: [workSheetId], references: [id], onDelete: Cascade)
  storageName      String    @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  label            String    @default("")
  position         Int       @default(0)
  uploadedById     String
  uploadedBy       User      @relation("WorkSheetPhotosUploaded", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@index([workSheetId, position])
}

model Tag {
  id         String         @id @default(cuid())
  name       String         @unique
  color      String         @default("#6c757d")
  active     Boolean        @default(true)
  position   Int            @default(0)
  workSheets WorkSheetTag[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([active, position])
}

model WorkSheetTag {
  workSheetId String
  tagId       String
  workSheet   WorkSheet @relation(fields: [workSheetId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([workSheetId, tagId])
  @@index([tagId])
}

model AppSettings {
  id                      Int       @id @default(1)
  dolibarrUrl             String    @default("")
  dolibarrApiKeyEncrypted String    @default("")
  dolibarrEventsSyncedAt  DateTime?
  dolibarrLastSyncError   String?
  proximitySuggestionsSyncedAt DateTime?
  // Sauvegarde automatique de la base : `null` (ou 0) = désactivée. Même tandem
  // `*RunAt`/`*Error` que la synchronisation Dolibarr juste au-dessus.
  // Dernier import du répertoire Dolibarr (utilisateurs + sociétés) et son éventuelle erreur.
  dolibarrDirectorySyncedAt DateTime?
  dolibarrDirectoryError    String?
  backupIntervalHours     Int?
  backupLastRunAt         DateTime?
  backupLastError         String?
  // Notifications push (Web Push). La clé **publique** n'est pas secrète : le navigateur en a
  // besoin pour s'abonner, elle est donc stockée en clair. Seule la privée est chiffrée.
  vapidPublicKey           String   @default("")
  vapidPrivateKeyEncrypted String   @default("")
  vapidSubject             String   @default("")
  // E-mail sortant (Resend) : clé chiffrée, expéditeur en clair.
  resendApiKeyEncrypted    String   @default("")
  emailFrom                String   @default("")
  updatedAt               DateTime  @updatedAt
}

model DocumentIssuer {
  id                           String    @id @default(cuid())
  name                         String    @unique
  address                      String    @default("")
  phone                        String    @default("")
  email                        String    @default("")
  defaultResponsible           String    @default("")
  refrigerantAttestationNumber String    @default("")
  leakDetectorId               String    @default("")
  leakDetectorInspectionDate   DateTime?
  logoData                     String    @default("")
  stampData                    String    @default("")
  signatureData                String    @default("")
  active                       Boolean   @default(true)
  latitude                     Float?
  longitude                    Float?
  isHeadquarters               Boolean   @default(false)
  generatedDocuments           GeneratedDocument[]
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([active, name])
}

enum DocumentFieldType {
  TEXT
  CHECKBOX
}

model DocumentTemplate {
  id                 String              @id @default(cuid())
  name               String
  storageName        String              @unique
  originalFileName   String
  checksumSha256     String
  sizeBytes          Int
  active             Boolean             @default(true)
  fields             Json
  createdById        String
  createdBy          User                @relation("DocumentTemplatesCreated", fields: [createdById], references: [id], onDelete: Restrict)
  generatedDocuments GeneratedDocument[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([active, name])
}

model GeneratedDocument {
  id            String           @id @default(cuid())
  eventId       String           @default("")
  clientLabel   String           @default("")
  templateId    String
  template      DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  issuerId      String?
  issuer        DocumentIssuer?  @relation(fields: [issuerId], references: [id], onDelete: SetNull)
  storageName   String           @unique
  dynamicFields Json
  enabledFields Json
  generatedById String
  generatedBy   User             @relation("DocumentsGenerated", fields: [generatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([eventId])
  @@index([templateId])
  @@index([clientLabel])
}

model WorkSheetItem {
  id                    String           @id @default(cuid())
  workSheetId           String
  workSheet             WorkSheet        @relation(fields: [workSheetId], references: [id], onDelete: Cascade)
  materialId            String?
  material              Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  variantId             String?
  variant               MaterialVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  categoryNameSnapshot  String
  materialNameSnapshot  String
  reportLabelSnapshot   String
  variantNameSnapshot   String?
  variantReportSnapshot String?
  unitSnapshot          MaterialUnit
  quantity              Float            @default(1)
  detailValue           Float?
  supplier              MaterialSupplier @default(INTERNAL)
  installed             Boolean          @default(true)
  position              Int              @default(0)
  createdAt             DateTime         @default(now())

  @@index([workSheetId, position])
  @@index([materialId])
}

model WorkSheetInstallation {
  id                  String           @id @default(cuid())
  workSheetId         String
  workSheet           WorkSheet        @relation(fields: [workSheetId], references: [id], onDelete: Cascade)
  designationSnapshot String
  quantity            Float            @default(1)
  supplier            MaterialSupplier @default(INTERNAL)
  sourceSupplier      String           @default("")
  deliveryNote        String           @default("")
  installed           Boolean          @default(true)
  position            Int              @default(0)
  createdAt           DateTime         @default(now())

  @@index([workSheetId, position])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model PacBrand {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  models    HeatPump[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Refrigerant {
  id        String      @id @default(cuid())
  name      String      @unique
  gwp       Float
  active    Boolean     @default(true)
  models    HeatPump[]
  equipment Equipment[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model HeatPump {
  id                       String                           @id @default(cuid())
  name                     String
  brandId                  String
  brand                    PacBrand                         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  type                     HeatPumpType                     @default(AIR_WATER)
  configuration            HeatPumpConfiguration            @default(SPLIT)
  electricalSupply         ElectricalSupply                 @default(SINGLE_PHASE)
  powerKw                  Float?
  outdoorReference         String                           @default("")
  indoorReference          String                           @default("")
  splitLiaisonType         HeatPumpSplitLiaisonType?
  refrigerantId            String?
  refrigerant              Refrigerant?                     @relation(fields: [refrigerantId], references: [id], onDelete: SetNull)
  factoryChargeKg          Float?
  maxPipeLengthM           Float?
  maxHeightDifferenceM     Float?
  includedPipeLengthM      Float?
  additionalChargeGPerM    Float?
  liquidPipeDiameter       String                           @default("")
  gasPipeDiameter          String                           @default("")
  powerCable               String                           @default("")
  indoorPowerCable         String                           @default("")
  outdoorPowerCable        String                           @default("")
  recommendedProtection    String                           @default("")
  communicationCable       String                           @default("")
  hydraulicConnections     String                           @default("")
  minimumFlow              String                           @default("")
  minimumWaterVolume       String                           @default("")
  maximumFlowTemperature   String                           @default("")
  bufferTankRecommendation String                           @default("")
  commissioningNotes       String                           @default("")
  installationNotes        String                           @default("")
  internalNotes            String                           @default("")
  active                   Boolean                          @default(true)
  documents                PacDocument[]
  equipmentMappings        LegacyHeatPumpEquipment[]
  combinationMapping       LegacyHeatPumpSystemCombination?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@unique([brandId, name])
  @@index([brandId, active])
  @@index([refrigerantId])
}

model PacDocument {
  id                String             @id @default(cuid())
  heatPumpId        String
  heatPump          HeatPump           @relation(fields: [heatPumpId], references: [id], onDelete: Cascade)
  name              String
  type              PacDocumentType    @default(OTHER)
  originalName      String
  storageName       String             @unique
  mimeType          String
  sizeBytes         Int
  version           String             @default("")
  documentDate      DateTime?
  primary           Boolean            @default(false)
  technicalDocument TechnicalDocument?
  createdAt         DateTime           @default(now())

  @@index([heatPumpId, type])
}

model Manufacturer {
  id                 String              @id @default(cuid())
  name               String
  normalizedName     String              @unique
  active             Boolean             @default(true)
  productRanges      ProductRange[]
  equipment          Equipment[]
  systemCombinations SystemCombination[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([active, name])
}

model ProductRange {
  id                 String              @id @default(cuid())
  manufacturerId     String
  manufacturer       Manufacturer        @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  name               String
  normalizedName     String
  legacyPacRangeId   String?             @unique
  active             Boolean             @default(true)
  equipment          Equipment[]
  systemCombinations SystemCombination[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([manufacturerId, normalizedName])
  @@index([manufacturerId, active])
}

model Equipment {
  // Identification
  id                    String        @id @default(cuid())
  manufacturerId        String
  manufacturer          Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  productRangeId        String?
  productRange          ProductRange? @relation(fields: [productRangeId], references: [id], onDelete: SetNull)
  type                  EquipmentType
  name                  String
  manufacturerReference String
  normalizedReference   String
  referenceNeedsReview  Boolean       @default(false)

  // Electrical supply and protection
  electricalSupply      ElectricalSupply?
  recommendedProtection String            @default("")

  // Cables
  powerCable         String @default("")
  communicationCable String @default("")

  // Refrigeration
  refrigerantId   String?
  refrigerant     Refrigerant? @relation(fields: [refrigerantId], references: [id], onDelete: Restrict)
  factoryChargeKg Float?

  // Refrigerant line sizes and limits
  maxPipeLengthM        Float?
  maxHeightDifferenceM  Float?
  includedPipeLengthM   Float?
  additionalChargeGPerM Float?
  liquidPipeDiameter    String @default("")
  gasPipeDiameter       String @default("")

  // Hydraulics
  hydraulicConnections     String @default("")
  minimumFlow              String @default("")
  minimumWaterVolume       String @default("")
  maximumFlowTemperature   String @default("")
  bufferTankRecommendation String @default("")

  // Basic performance
  nominalPowerKw Float?

  // Notes
  commissioningNotes String @default("")
  installationNotes  String @default("")
  internalNotes      String @default("")

  active              Boolean                      @default(true)
  combinationParts    CombinationComponent[]
  indoorCombinations  SystemCombination[]          @relation("SystemCombinationIndoorEquipment")
  outdoorCombinations SystemCombination[]          @relation("SystemCombinationOutdoorEquipment")
  technicalDocuments  EquipmentTechnicalDocument[]
  interventionUsages  InterventionMaterial[]
  legacyMappings      LegacyHeatPumpEquipment[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([manufacturerId, normalizedReference])
  @@index([manufacturerId, type, active])
  @@index([productRangeId])
  @@index([refrigerantId])
}

model SystemCombination {
  id                 String                               @id @default(cuid())
  manufacturerId     String
  manufacturer       Manufacturer                         @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  productRangeId     String?
  productRange       ProductRange?                        @relation(fields: [productRangeId], references: [id], onDelete: SetNull)
  name               String
  normalizedName     String
  applicationType    HeatPumpType?
  splitLiaisonType   HeatPumpSplitLiaisonType?
  electricalSupply   ElectricalSupply?
  nominalPowerKw     Float?
  commissioningNotes String                               @default("")
  installationNotes  String                               @default("")
  internalNotes      String                               @default("")
  active             Boolean                              @default(true)
  indoorEquipmentId  String
  indoorEquipment    Equipment                            @relation("SystemCombinationIndoorEquipment", fields: [indoorEquipmentId], references: [id], onDelete: Restrict)
  outdoorEquipmentId String
  outdoorEquipment   Equipment                            @relation("SystemCombinationOutdoorEquipment", fields: [outdoorEquipmentId], references: [id], onDelete: Restrict)
  components         CombinationComponent[]
  technicalDocuments SystemCombinationTechnicalDocument[]
  legacyMappings     LegacyHeatPumpSystemCombination[]
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt

  @@unique([manufacturerId, normalizedName])
  @@unique([indoorEquipmentId, outdoorEquipmentId])
  @@index([manufacturerId, active])
  @@index([productRangeId])
  @@index([indoorEquipmentId])
  @@index([outdoorEquipmentId])
}

model CombinationComponent {
  id                  String            @id @default(cuid())
  systemCombinationId String
  systemCombination   SystemCombination @relation(fields: [systemCombinationId], references: [id], onDelete: Cascade)
  equipmentId         String
  equipment           Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  role                EquipmentType
  quantity            Int               @default(1)
  position            Int               @default(0)
  required            Boolean           @default(true)
  notes               String            @default("")
  createdAt           DateTime          @default(now())

  @@unique([systemCombinationId, equipmentId])
  @@unique([systemCombinationId, role])
  @@index([equipmentId])
}

model CombinationComponentMigrationArchive {
  id                  String        @id
  migrationName       String
  originalComponentId String
  systemCombinationId String
  equipmentId         String
  role                EquipmentType
  quantity            Int
  position            Int
  required            Boolean
  notes               String
  sourceCreatedAt     DateTime
  reason              String
  provenance          Json
  snapshot            Json
  archivedAt          DateTime      @default(now())

  @@unique([migrationName, originalComponentId], map: "CombinationComponentMigrationArchive_migrationName_originalComp")
  @@index([systemCombinationId])
  @@index([equipmentId])
  @@index([archivedAt])
}

model TechnicalDocument {
  id                  String                               @id @default(cuid())
  legacyPacDocumentId String?                              @unique
  legacyPacDocument   PacDocument?                         @relation(fields: [legacyPacDocumentId], references: [id], onDelete: SetNull)
  title               String
  type                TechnicalDocumentType                @default(OTHER)
  originalFileName    String
  storageName         String                               @unique
  checksumSha256      String?                              @unique
  mimeType            String
  sizeBytes           Int
  version             String                               @default("")
  documentDate        DateTime?
  isPrimary           Boolean                              @default(false)
  active              Boolean                              @default(true)
  equipment           EquipmentTechnicalDocument[]
  systemCombinations  SystemCombinationTechnicalDocument[]
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  @@index([type, active])
}

model EquipmentTechnicalDocument {
  equipmentId         String
  equipment           Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  technicalDocumentId String
  technicalDocument   TechnicalDocument @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@id([equipmentId, technicalDocumentId])
  @@index([technicalDocumentId])
}

model SystemCombinationTechnicalDocument {
  systemCombinationId String
  systemCombination   SystemCombination @relation(fields: [systemCombinationId], references: [id], onDelete: Cascade)
  technicalDocumentId String
  technicalDocument   TechnicalDocument @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@id([systemCombinationId, technicalDocumentId])
  @@index([technicalDocumentId])
}

model LegacyHeatPumpEquipment {
  heatPumpId  String
  heatPump    HeatPump      @relation(fields: [heatPumpId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  role        EquipmentType
  createdAt   DateTime      @default(now())

  @@id([heatPumpId, equipmentId, role])
  @@index([equipmentId])
}

model LegacyHeatPumpSystemCombination {
  heatPumpId          String            @id
  heatPump            HeatPump          @relation(fields: [heatPumpId], references: [id], onDelete: Cascade)
  systemCombinationId String
  systemCombination   SystemCombination @relation(fields: [systemCombinationId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@index([systemCombinationId])
}
