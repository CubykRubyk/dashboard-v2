generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum MaterialInputType {
  CHECKBOX
  QUANTITY
  SELECT
  DETAIL
}

enum MaterialUnit {
  NONE
  PIECE
  METER
  BAG
  RADIATOR
}

enum WorkSheetStatus {
  DRAFT
  COMPLETED
  SENT
}

enum MaterialSupplier {
  COMPANY
  INTERNAL
}

enum HeatPumpType {
  AIR_WATER
  AIR_AIR
  GROUND_WATER
}

enum HeatPumpConfiguration {
  SPLIT
  MONOBLOC
}

enum HeatPumpSplitLiaisonType {
  FRIGORIFIC
  HYDRAULIC
}

enum ElectricalSupply {
  SINGLE_PHASE
  THREE_PHASE
}

enum PacDocumentType {
  INSTALLATION_MANUAL
  USER_MANUAL
  DATASHEET
  WIRING_DIAGRAM
  ERROR_CODES
  CERTIFICATE
  OTHER
}

enum EquipmentType {
  INDOOR_UNIT
  OUTDOOR_UNIT
  MONOBLOC
  ACCESSORY
  CONTROLLER
  OTHER
}

enum TechnicalDocumentType {
  INSTALLATION_MANUAL
  USER_MANUAL
  DATASHEET
  WIRING_DIAGRAM
  ERROR_CODES
  CERTIFICATE
  OTHER
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         UserRole    @default(OPERATOR)
  active       Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  workSheets   WorkSheet[]
}

model MaterialCategory {
  id        String     @id @default(cuid())
  key       String     @unique
  name      String
  position  Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  materials Material[]
}

model Material {
  id                String            @id @default(cuid())
  key               String            @unique
  name              String
  reportLabel       String
  inputType         MaterialInputType @default(CHECKBOX)
  unit              MaterialUnit      @default(PIECE)
  defaultQuantity   Float             @default(1)
  detailLabel       String?
  position          Int               @default(0)
  active            Boolean           @default(true)
  allowSupplier     Boolean           @default(true)
  allowNotInstalled Boolean           @default(true)
  categoryId        String
  category          MaterialCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants          MaterialVariant[]
  workSheetItems    WorkSheetItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([categoryId, position])
}

model MaterialVariant {
  id             String          @id @default(cuid())
  name           String
  reportLabel    String
  position       Int             @default(0)
  active         Boolean         @default(true)
  materialId     String
  material       Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workSheetItems WorkSheetItem[]

  @@unique([materialId, name])
  @@index([materialId, position])
}

model WorkSheet {
  id                String                  @id @default(cuid())
  legacyId          String?                 @unique
  workDate          DateTime?
  client            String
  company           String
  installer         String
  eventId           String?
  mainInstallations String                  @default("")
  otherMaterials    String                  @default("")
  reportText        String                  @default("")
  reportFrozen      Boolean                 @default(false)
  status            WorkSheetStatus         @default(DRAFT)
  dolibarrSentAt    DateTime?
  dolibarrLastError String?
  archivedAt        DateTime?
  createdById       String
  createdBy         User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  installations     WorkSheetInstallation[]
  items             WorkSheetItem[]
  tags              WorkSheetTag[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([workDate])
  @@index([archivedAt, createdAt])
}

model Tag {
  id         String         @id @default(cuid())
  name       String         @unique
  color      String         @default("#6c757d")
  active     Boolean        @default(true)
  position   Int            @default(0)
  workSheets WorkSheetTag[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([active, position])
}

model WorkSheetTag {
  workSheetId String
  tagId       String
  workSheet   WorkSheet @relation(fields: [workSheetId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([workSheetId, tagId])
  @@index([tagId])
}

model AppSettings {
  id                      Int      @id @default(1)
  dolibarrUrl             String   @default("")
  dolibarrApiKeyEncrypted String   @default("")
  updatedAt               DateTime @updatedAt
}

model DocumentIssuer {
  id                           String              @id @default(cuid())
  name                         String              @unique
  address                      String              @default("")
  phone                        String              @default("")
  email                        String              @default("")
  defaultResponsible           String              @default("")
  refrigerantAttestationNumber String              @default("")
  leakDetectorId               String              @default("")
  leakDetectorInspectionDate   DateTime?
  logoData                     String              @default("")
  stampData                    String              @default("")
  signatureData                String              @default("")
  active                       Boolean             @default(true)
  generatedDocuments           GeneratedDocument[]
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  @@index([active, name])
}

model DocumentTemplate {
  id                 String              @id @default(cuid())
  name               String
  originalFileName   String
  storageName        String              @unique
  mimeType           String              @default("application/pdf")
  sizeBytes          Int
  checksumSha256     String              @unique
  fields             Json
  active             Boolean             @default(true)
  version            Int                 @default(1)
  generatedDocuments GeneratedDocument[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([active, name])
}

model GeneratedDocument {
  id                  String             @id @default(cuid())
  templateId          String
  template            DocumentTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  issuerId            String?
  issuer              DocumentIssuer?    @relation(fields: [issuerId], references: [id], onDelete: SetNull)
  systemCombinationId String?
  systemCombination   SystemCombination? @relation(fields: [systemCombinationId], references: [id], onDelete: SetNull)
  title               String
  originalFileName    String
  storageName         String             @unique
  mimeType            String             @default("application/pdf")
  sizeBytes           Int
  checksumSha256      String             @unique
  dolibarrEventId     String
  dateDocument        DateTime?
  clientName          String             @default("")
  siteAddress         String             @default("")
  responsible         String             @default("")
  manualFields        Json
  sourceSnapshot      Json
  createdAt           DateTime           @default(now())

  @@index([dolibarrEventId])
  @@index([issuerId, createdAt])
  @@index([systemCombinationId])
}

model WorkSheetItem {
  id                    String           @id @default(cuid())
  workSheetId           String
  workSheet             WorkSheet        @relation(fields: [workSheetId], references: [id], onDelete: Cascade)
  materialId            String?
  material              Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  variantId             String?
  variant               MaterialVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  categoryNameSnapshot  String
  materialNameSnapshot  String
  reportLabelSnapshot   String
  variantNameSnapshot   String?
  variantReportSnapshot String?
  unitSnapshot          MaterialUnit
  quantity              Float            @default(1)
  detailValue           Float?
  supplier              MaterialSupplier @default(INTERNAL)
  installed             Boolean          @default(true)
  position              Int              @default(0)
  createdAt             DateTime         @default(now())

  @@index([workSheetId, position])
  @@index([materialId])
}

model WorkSheetInstallation {
  id                  String           @id @default(cuid())
  workSheetId         String
  workSheet           WorkSheet        @relation(fields: [workSheetId], references: [id], onDelete: Cascade)
  designationSnapshot String
  quantity            Float            @default(1)
  supplier            MaterialSupplier @default(INTERNAL)
  sourceSupplier      String           @default("")
  deliveryNote        String           @default("")
  installed           Boolean          @default(true)
  position            Int              @default(0)
  createdAt           DateTime         @default(now())

  @@index([workSheetId, position])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model PacBrand {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  models    HeatPump[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Refrigerant {
  id        String      @id @default(cuid())
  name      String      @unique
  gwp       Float
  active    Boolean     @default(true)
  models    HeatPump[]
  equipment Equipment[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model HeatPump {
  id                       String                           @id @default(cuid())
  name                     String
  brandId                  String
  brand                    PacBrand                         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  type                     HeatPumpType                     @default(AIR_WATER)
  configuration            HeatPumpConfiguration            @default(SPLIT)
  electricalSupply         ElectricalSupply                 @default(SINGLE_PHASE)
  powerKw                  Float?
  outdoorReference         String                           @default("")
  indoorReference          String                           @default("")
  splitLiaisonType         HeatPumpSplitLiaisonType?
  refrigerantId            String?
  refrigerant              Refrigerant?                     @relation(fields: [refrigerantId], references: [id], onDelete: SetNull)
  factoryChargeKg          Float?
  maxPipeLengthM           Float?
  maxHeightDifferenceM     Float?
  includedPipeLengthM      Float?
  additionalChargeGPerM    Float?
  liquidPipeDiameter       String                           @default("")
  gasPipeDiameter          String                           @default("")
  powerCable               String                           @default("")
  indoorPowerCable         String                           @default("")
  outdoorPowerCable        String                           @default("")
  recommendedProtection    String                           @default("")
  communicationCable       String                           @default("")
  hydraulicConnections     String                           @default("")
  minimumFlow              String                           @default("")
  minimumWaterVolume       String                           @default("")
  maximumFlowTemperature   String                           @default("")
  bufferTankRecommendation String                           @default("")
  commissioningNotes       String                           @default("")
  installationNotes        String                           @default("")
  internalNotes            String                           @default("")
  active                   Boolean                          @default(true)
  documents                PacDocument[]
  equipmentMappings        LegacyHeatPumpEquipment[]
  combinationMapping       LegacyHeatPumpSystemCombination?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@unique([brandId, name])
  @@index([brandId, active])
  @@index([refrigerantId])
}

model PacDocument {
  id                String             @id @default(cuid())
  heatPumpId        String
  heatPump          HeatPump           @relation(fields: [heatPumpId], references: [id], onDelete: Cascade)
  name              String
  type              PacDocumentType    @default(OTHER)
  originalName      String
  storageName       String             @unique
  mimeType          String
  sizeBytes         Int
  version           String             @default("")
  documentDate      DateTime?
  primary           Boolean            @default(false)
  technicalDocument TechnicalDocument?
  createdAt         DateTime           @default(now())

  @@index([heatPumpId, type])
}

model Manufacturer {
  id                 String              @id @default(cuid())
  name               String
  normalizedName     String              @unique
  active             Boolean             @default(true)
  productRanges      ProductRange[]
  equipment          Equipment[]
  systemCombinations SystemCombination[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([active, name])
}

model ProductRange {
  id                 String              @id @default(cuid())
  manufacturerId     String
  manufacturer       Manufacturer        @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  name               String
  normalizedName     String
  legacyPacRangeId   String?             @unique
  active             Boolean             @default(true)
  equipment          Equipment[]
  systemCombinations SystemCombination[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([manufacturerId, normalizedName])
  @@index([manufacturerId, active])
}

model Equipment {
  // Identification
  id                    String        @id @default(cuid())
  manufacturerId        String
  manufacturer          Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  productRangeId        String?
  productRange          ProductRange? @relation(fields: [productRangeId], references: [id], onDelete: SetNull)
  type                  EquipmentType
  name                  String
  manufacturerReference String
  normalizedReference   String
  referenceNeedsReview  Boolean       @default(false)

  // Electrical supply and protection
  electricalSupply      ElectricalSupply?
  recommendedProtection String            @default("")

  // Cables
  powerCable         String @default("")
  communicationCable String @default("")

  // Refrigeration
  refrigerantId   String?
  refrigerant     Refrigerant? @relation(fields: [refrigerantId], references: [id], onDelete: Restrict)
  factoryChargeKg Float?

  // Refrigerant line sizes and limits
  maxPipeLengthM        Float?
  maxHeightDifferenceM  Float?
  includedPipeLengthM   Float?
  additionalChargeGPerM Float?
  liquidPipeDiameter    String @default("")
  gasPipeDiameter       String @default("")

  // Hydraulics
  hydraulicConnections     String @default("")
  minimumFlow              String @default("")
  minimumWaterVolume       String @default("")
  maximumFlowTemperature   String @default("")
  bufferTankRecommendation String @default("")

  // Basic performance
  nominalPowerKw Float?

  // Notes
  commissioningNotes String @default("")
  installationNotes  String @default("")
  internalNotes      String @default("")

  active              Boolean                      @default(true)
  combinationParts    CombinationComponent[]
  indoorCombinations  SystemCombination[]          @relation("SystemCombinationIndoorEquipment")
  outdoorCombinations SystemCombination[]          @relation("SystemCombinationOutdoorEquipment")
  technicalDocuments  EquipmentTechnicalDocument[]
  legacyMappings      LegacyHeatPumpEquipment[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([manufacturerId, normalizedReference])
  @@index([manufacturerId, type, active])
  @@index([productRangeId])
  @@index([refrigerantId])
}

model SystemCombination {
  id                 String                               @id @default(cuid())
  manufacturerId     String
  manufacturer       Manufacturer                         @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  productRangeId     String?
  productRange       ProductRange?                        @relation(fields: [productRangeId], references: [id], onDelete: SetNull)
  name               String
  normalizedName     String
  applicationType    HeatPumpType?
  splitLiaisonType   HeatPumpSplitLiaisonType?
  electricalSupply   ElectricalSupply?
  nominalPowerKw     Float?
  commissioningNotes String                               @default("")
  installationNotes  String                               @default("")
  internalNotes      String                               @default("")
  active             Boolean                              @default(true)
  indoorEquipmentId  String
  indoorEquipment    Equipment                            @relation("SystemCombinationIndoorEquipment", fields: [indoorEquipmentId], references: [id], onDelete: Restrict)
  outdoorEquipmentId String
  outdoorEquipment   Equipment                            @relation("SystemCombinationOutdoorEquipment", fields: [outdoorEquipmentId], references: [id], onDelete: Restrict)
  components         CombinationComponent[]
  technicalDocuments SystemCombinationTechnicalDocument[]
  legacyMappings     LegacyHeatPumpSystemCombination[]
  generatedDocuments GeneratedDocument[]
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt

  @@unique([manufacturerId, normalizedName])
  @@unique([indoorEquipmentId, outdoorEquipmentId])
  @@index([manufacturerId, active])
  @@index([productRangeId])
  @@index([indoorEquipmentId])
  @@index([outdoorEquipmentId])
}

model CombinationComponent {
  id                  String            @id @default(cuid())
  systemCombinationId String
  systemCombination   SystemCombination @relation(fields: [systemCombinationId], references: [id], onDelete: Cascade)
  equipmentId         String
  equipment           Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  role                EquipmentType
  quantity            Int               @default(1)
  position            Int               @default(0)
  required            Boolean           @default(true)
  notes               String            @default("")
  createdAt           DateTime          @default(now())

  @@unique([systemCombinationId, equipmentId])
  @@unique([systemCombinationId, role])
  @@index([equipmentId])
}

model CombinationComponentMigrationArchive {
  id                  String        @id
  migrationName       String
  originalComponentId String
  systemCombinationId String
  equipmentId         String
  role                EquipmentType
  quantity            Int
  position            Int
  required            Boolean
  notes               String
  sourceCreatedAt     DateTime
  reason              String
  provenance          Json
  snapshot            Json
  archivedAt          DateTime      @default(now())

  @@unique([migrationName, originalComponentId], map: "CombinationComponentMigrationArchive_migrationName_originalComp")
  @@index([systemCombinationId])
  @@index([equipmentId])
  @@index([archivedAt])
}

model TechnicalDocument {
  id                  String                               @id @default(cuid())
  legacyPacDocumentId String?                              @unique
  legacyPacDocument   PacDocument?                         @relation(fields: [legacyPacDocumentId], references: [id], onDelete: SetNull)
  title               String
  type                TechnicalDocumentType                @default(OTHER)
  originalFileName    String
  storageName         String                               @unique
  checksumSha256      String?                              @unique
  mimeType            String
  sizeBytes           Int
  version             String                               @default("")
  documentDate        DateTime?
  isPrimary           Boolean                              @default(false)
  active              Boolean                              @default(true)
  equipment           EquipmentTechnicalDocument[]
  systemCombinations  SystemCombinationTechnicalDocument[]
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  @@index([type, active])
}

model EquipmentTechnicalDocument {
  equipmentId         String
  equipment           Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  technicalDocumentId String
  technicalDocument   TechnicalDocument @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@id([equipmentId, technicalDocumentId])
  @@index([technicalDocumentId])
}

model SystemCombinationTechnicalDocument {
  systemCombinationId String
  systemCombination   SystemCombination @relation(fields: [systemCombinationId], references: [id], onDelete: Cascade)
  technicalDocumentId String
  technicalDocument   TechnicalDocument @relation(fields: [technicalDocumentId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@id([systemCombinationId, technicalDocumentId])
  @@index([technicalDocumentId])
}

model LegacyHeatPumpEquipment {
  heatPumpId  String
  heatPump    HeatPump      @relation(fields: [heatPumpId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  role        EquipmentType
  createdAt   DateTime      @default(now())

  @@id([heatPumpId, equipmentId, role])
  @@index([equipmentId])
}

model LegacyHeatPumpSystemCombination {
  heatPumpId          String            @id
  heatPump            HeatPump          @relation(fields: [heatPumpId], references: [id], onDelete: Cascade)
  systemCombinationId String
  systemCombination   SystemCombination @relation(fields: [systemCombinationId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@index([systemCombinationId])
}
