generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum MaterialInputType {
  CHECKBOX
  QUANTITY
  SELECT
  DETAIL
}

enum MaterialUnit {
  NONE
  PIECE
  METER
  BAG
  RADIATOR
}

enum WorkSheetStatus {
  DRAFT
  COMPLETED
  SENT
}

enum MaterialSupplier {
  COMPANY
  INTERNAL
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(OPERATOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
  workSheets   WorkSheet[]
}

model MaterialCategory {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  position    Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  materials   Material[]
}

model Material {
  id                String            @id @default(cuid())
  key               String            @unique
  name              String
  reportLabel       String
  inputType         MaterialInputType @default(CHECKBOX)
  unit              MaterialUnit      @default(PIECE)
  defaultQuantity   Float             @default(1)
  detailLabel       String?
  position          Int               @default(0)
  active            Boolean           @default(true)
  allowSupplier     Boolean           @default(true)
  allowNotInstalled Boolean           @default(true)
  categoryId        String
  category          MaterialCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants          MaterialVariant[]
  workSheetItems    WorkSheetItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([categoryId, position])
}

model MaterialVariant {
  id          String   @id @default(cuid())
  name        String
  reportLabel String
  position    Int      @default(0)
  active      Boolean  @default(true)
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workSheetItems WorkSheetItem[]

  @@unique([materialId, name])
  @@index([materialId, position])
}

model WorkSheet {
  id                String          @id @default(cuid())
  workDate          DateTime?
  client            String
  company           String
  installer         String
  eventId           String?
  mainInstallations String          @default("")
  otherMaterials    String          @default("")
  reportText        String          @default("")
  reportFrozen      Boolean         @default(false)
  status            WorkSheetStatus @default(DRAFT)
  archivedAt        DateTime?
  createdById       String
  createdBy         User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items             WorkSheetItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workDate])
  @@index([archivedAt, createdAt])
}

model WorkSheetItem {
  id                    String           @id @default(cuid())
  workSheetId           String
  workSheet             WorkSheet        @relation(fields: [workSheetId], references: [id], onDelete: Cascade)
  materialId            String?
  material              Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  variantId             String?
  variant               MaterialVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  categoryNameSnapshot  String
  materialNameSnapshot  String
  reportLabelSnapshot   String
  variantNameSnapshot   String?
  variantReportSnapshot String?
  unitSnapshot          MaterialUnit
  quantity              Float            @default(1)
  detailValue           Float?
  supplier              MaterialSupplier @default(INTERNAL)
  installed             Boolean          @default(true)
  position              Int              @default(0)
  createdAt             DateTime         @default(now())

  @@index([workSheetId, position])
  @@index([materialId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
